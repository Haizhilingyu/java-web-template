/*
 * 1.  本文件由 jimmer-apt 编译，修改本文件后需要重新构建项目
 *     (若同时修改了其他 Java 代码，可直接在 IDEA 中点击 Run)
 *
 * 2.  实体定义在本模块 model 包，需要
 *     com.jezetek.modules.system.service.DtoGeneration 上的
 *     @EnableDtoGeneration 手动启用 DTO 文件编译
 *
 * 3.  input 属性块中的校验注解(jakarta.validation.constraints)会生成到
 *     UserInput 类上，由 service 保存方法上的 @Valid 触发校验
 */

export com.jezetek.modules.system.model.User
    -> package com.jezetek.modules.system.service.dto


input UserInput {

    id

    @jakarta.validation.constraints.NotBlank(message = "用户名不能为空")
    @jakarta.validation.constraints.Size(min = 3, max = 50, message = "用户名长度必须在3~50之间")
    @jakarta.validation.constraints.Pattern(regexp = "[a-zA-Z0-9_]+", message = "用户名只能包含字母、数字和下划线")
    username

    @jakarta.validation.constraints.Size(max = 100, message = "密码长度不能超过100")
    password

    @jakarta.validation.constraints.Size(max = 50, message = "昵称长度不能超过50")
    nickname

    enabled

    id(dept) as deptId

    id(posts) as postIds

    id(roles) as roleIds
}

specification UserSpecification {
    like/i(username, nickname) as keyword
    eq(enabled)
    flat(roles) {
        like/i(name) as roleName
    }
}
