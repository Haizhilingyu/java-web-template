/*
 * 1.  本文件由 jimmer-apt 编译，修改本文件后需要重新构建项目
 *     (若同时修改了其他 Java 代码，可直接在 IDEA 中点击 Run)
 *
 * 2.  实体定义在 core/model 模块，本模块没有 @Entity 类型，
 *     需要 com.jezetek.core.service.DtoGeneration 上的 @EnableDtoGeneration
 *     手动启用 DTO 文件编译
 *
 * 3.  input 属性块中的校验注解(jakarta.validation.constraints)会生成到
 *     MenuInput 类上，由 service 保存方法上的 @Valid 触发校验
 */

export com.jezetek.core.model.Menu
    -> package com.jezetek.core.service.dto

input MenuInput {

    id

    @jakarta.validation.constraints.NotBlank(message = "菜单名不能为空")
    @jakarta.validation.constraints.Size(max = 50, message = "菜单名长度不能超过50")
    name

    id(parent) as parentId

    @jakarta.validation.constraints.Size(max = 200, message = "路由地址长度不能超过200")
    path

    @jakarta.validation.constraints.Size(max = 100, message = "图标名长度不能超过100")
    icon

    @jakarta.validation.constraints.Min(value = 0, message = "排序号不能为负数")
    sortOrder
}

specification MenuSpecification {
    like/i(name, path) as keyword
    flat(parent) {
        like/i(name) as parentName
    }
}
